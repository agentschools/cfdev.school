{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-dev-school",
  // Custom entry wrapping Astro's handler so it can export the ProgressHub Durable Object.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-dev-school",
      "database_id": "2c5a6216-085a-4896-8d0f-13255adbdefc",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "994f1484fe95462f89b748b3ee7be2ff"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROGRESS_HUB",
        "class_name": "ProgressHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProgressHub"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
