{
  "name": "cloudflare-dev-school",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "astro build && wrangler d1 migrations apply cloudflare-dev-school --local --persist-to .wrangler/state && wrangler dev -c dist/server/wrangler.json --port 8788 --persist-to .wrangler/state --local-upstream localhost:8788",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "lint": "eslint .",
    "deploy": "wrangler d1 migrations apply cloudflare-dev-school --remote && astro build && wrangler deploy",
    "preview:deploy": "node scripts/preview-env.mjs deploy",
    "preview:destroy": "node scripts/preview-env.mjs destroy",
    "verify:interview": "node scripts/fake-agent-interview.mjs",
    "verify:exercise": "node scripts/fake-agent-exercise.mjs",
    "verify:exercise-kv": "node scripts/fake-agent-exercise-kv.mjs",
    "verify:external-course": "node scripts/fake-agent-external-course.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.6",
    "@floating-ui/dom": "1.8.0",
    "astro": "7.2.10",
    "zod": "4.5.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260901.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.11.0",
    "shiki": "4.4.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "wrangler": "4.128.0",
    "yaml": "2.9.1",
    "zod-openapi": "6.0.1"
  }
}
