---
import { getCollection, render } from "astro:content";
import AgentPrompt from "../../components/AgentPrompt.astro";
import Layout from "../../layouts/Layout.astro";
import { getExercise, listExercises } from "../../data/exercises";

export const prerender = false;

const { slug } = Astro.params;
const exercise = slug ? getExercise(slug) : undefined;
const entries = await getCollection("exercises", (entry) => entry.data.exerciseSlug === slug);
const pageEntry = entries[0];

if (!exercise || !pageEntry) {
  Astro.response.status = 404;
}

const { Content } = pageEntry ? await render(pageEntry) : { Content: null };

const all = listExercises();
const currentIndex = exercise ? all.findIndex((item) => item.slug === exercise.slug) : -1;
const next = currentIndex >= 0 && currentIndex < all.length - 1 ? all[currentIndex + 1] : null;

const title = exercise?.title ?? "Exercise not found";
const description = exercise?.description ?? "Exercise not found.";
---

<Layout title={`${title} — Cloudflare Dev School`} description={description}>
  <div class="page">
    <main class="content">
      {
        !exercise || !pageEntry || !Content ? (
          <p>This exercise doesn't exist.</p>
        ) : (
          <>
            <p class="back">
              <a href="/exercises">← All exercises</a>
            </p>

            <header class="header">
              <p class="eyebrow">Exercise {exercise.order}</p>
              <h1>{title}</h1>
              <p class="description">{description}</p>
            </header>

            <div id="exercise-completed-banner" class="completed-banner" hidden>
              <span id="exercise-completed-text">You completed this exercise!</span>
            </div>

            <div id="exercise-enroll-nudge" class="enroll-nudge" hidden>
              <p class="enroll-nudge-title">Enroll to get started</p>
              <p class="enroll-nudge-body">
                Enroll in Cloudflare Dev School to get a student ID. Then paste the exercise prompt into
                your agent, and it will guide you through this project step by step.
              </p>
              <a href="/" class="enroll-nudge-cta">Enroll for free</a>
            </div>

            <div class="prose">
              <Content />
            </div>

            <AgentPrompt />

            <div id="exercise-action" class="exercise-action" hidden>
              <button id="exercise-action-btn" type="button" class="exercise-action-btn">
                <span id="exercise-action-label">
                  {next ? `Next exercise: ${next.title} →` : "Mark this exercise as complete"}
                </span>
              </button>
            </div>
          </>
        )
      }
    </main>
  </div>
</Layout>

<script>
  import { initExercisePage } from "../../lib/exercise-client";
  initExercisePage();
</script>

<style>
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .content {
    padding: 2.5rem 0 5rem;
    max-width: 42rem;
  }

  .back {
    margin: 0 0 1.5rem;
  }

  .back a {
    color: var(--muted-fg);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back a:hover {
    color: var(--fg);
  }

  .header {
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.04em;
    color: var(--muted-fg);
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 0.75rem;
  }

  .description {
    margin: 0;
    color: var(--muted-fg);
    font-size: 1.1rem;
  }

  .completed-banner {
    margin: 0 0 1.5rem;
    padding: 0.85rem 1rem;
    border-radius: 0.6rem;
    background: color-mix(in oklch, var(--accent) 18%, transparent);
    color: var(--fg);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .enroll-nudge {
    margin: 0 0 1.75rem;
    padding: 1.25rem 1.35rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border);
    background: var(--card-bg);
  }

  .enroll-nudge-title {
    margin: 0 0 0.35rem;
    font-weight: 600;
  }

  .enroll-nudge-body {
    margin: 0 0 0.9rem;
    color: var(--muted-fg);
    font-size: 0.95rem;
  }

  .enroll-nudge-cta {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: 0.45rem;
    background: var(--accent);
    color: var(--accent-contrast);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .prose {
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .prose :global(h2) {
    font-size: 1.35rem;
    margin: 2rem 0 0.75rem;
  }

  .prose :global(p) {
    margin: 0 0 1rem;
  }

  .prose :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }

  .prose :global(a) {
    color: var(--accent);
  }

  .prose :global(pre) {
    margin: 0 0 1rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--card-bg) !important;
    white-space: pre-wrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    font-size: inherit;
  }

  @media (prefers-color-scheme: dark) {
    .prose :global(.astro-code),
    .prose :global(.astro-code span) {
      color: var(--shiki-dark) !important;
    }
  }

  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
  }

  .exercise-action {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .exercise-action-btn {
    display: flex;
    width: 100%;
    justify-content: center;
    align-items: center;
    padding: 1rem 1.5rem;
    border: none;
    border-radius: 0.6rem;
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }

  .exercise-action-btn:hover:not(:disabled) {
    filter: brightness(1.05);
  }

  .exercise-action-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
</style>
