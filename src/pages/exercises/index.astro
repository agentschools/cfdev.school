---
import Layout from "../../layouts/Layout.astro";
import { listExercises } from "../../data/exercises";

export const prerender = false;

const exercises = listExercises();
---

<Layout
  title="Exercises — Cloudflare Dev School"
  description="Hands-on exercises that build, deploy, and extend a Cloudflare Worker with your agent."
>
  <div class="page">
    <main class="content">
      <h1>Exercises</h1>
      <p class="lede">
        Short, hands-on projects your agent walks you through. Paste the prompt on each page into
        your agent and ship something real.
      </p>

      <ol class="exercise-list">
        {
          exercises.map((exercise) => (
            <li data-exercise-slug={exercise.slug}>
              <a href={`/exercises/${exercise.slug}`}>
                <span class="order">Exercise {exercise.order}</span>
                <span class="title-row">
                  <span class="title">{exercise.title}</span>
                  <span class="check" hidden>
                    ✓
                  </span>
                </span>
                <span class="description">{exercise.description}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </main>
  </div>
</Layout>

<script>
  import { initExercisesIndex } from "../../lib/exercise-client";
  initExercisesIndex();
</script>

<style>
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .content {
    padding: 2.5rem 0 5rem;
    max-width: 42rem;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 0.75rem;
  }

  .lede {
    margin: 0 0 2rem;
    color: var(--muted-fg);
    font-size: 1.1rem;
  }

  .exercise-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .exercise-list a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--card-bg);
    text-decoration: none;
    color: inherit;
  }

  .exercise-list a:hover {
    border-color: var(--accent);
  }

  .order {
    font-size: 0.75rem;
    font-weight: 600;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.04em;
    color: var(--muted-fg);
    text-transform: uppercase;
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .check {
    color: var(--accent);
    font-weight: 700;
  }

  .check[hidden] {
    display: none;
  }

  .description {
    color: var(--muted-fg);
    font-size: 0.95rem;
    line-height: 1.5;
  }
</style>
