---
import AgentPrompt from "../components/AgentPrompt.astro";
import HarnessCard from "../components/HarnessCard.astro";
import HarnessPicker from "../components/HarnessPicker.astro";
import StudentIdCard from "../components/StudentIdCard.astro";
import Layout from "../layouts/Layout.astro";
import { harnesses } from "../data/harnesses";
---

<Layout
  title="Cloudflare Dev School"
  description="Learn to build on Cloudflare using whatever AI coding agent you already have installed. Free forever, no account required."
  showSidebarBrand={false}
>
  <div class="page">
    <main class="content">
      <section id="overview" class="hero">
        <h1>Cloudflare Dev School</h1>
        <p class="lede">
          Learn to build on Cloudflare using whatever AI coding agent you already have installed. No account, no
          email, no credit card. All you need to get started is a working AI coding agent on your computer. We'll
          walk you through setting up Cloudflare.
        </p>
        <StudentIdCard />
        <div class="cta-block">
          <button class="cta cta-large" type="button" data-enroll-trigger>Enroll in Cloudflare Dev School</button>
          <p class="fine-print">Free forever. No account required. No personal data collected.</p>
        </div>
        <HarnessPicker />
        <AgentPrompt />
      </section>

      <section id="harnesses" class="harnesses">
        <h2>Supported harnesses</h2>
        <p class="section-lede">
          Cloudflare Dev School works with these agent harnesses out of the box, plus a generic path for anything
          else. See <a href="https://developers.cloudflare.com/agent-setup/">Cloudflare's agent setup docs</a> for the
          latest official tooling recommendations.
        </p>
        <div class="harness-grid">
          {harnesses.map((harness) => <HarnessCard harness={harness} />)}
        </div>
      </section>

    </main>
  </div>
</Layout>

<script>
  import { initHarnessPicker } from "../lib/harness-picker-client";
  // initEnrollment() runs globally from Layout.astro. Astro hoists that script
  // ahead of this one in the rendered HTML (page-level scripts don't reliably
  // run after layout-level ones), so initHarnessPicker() can't rely on
  // attaching its ENROLLED_EVENT listener before initEnrollment() dispatches
  // it for a returning visitor — it also checks for an already-cached student
  // directly as a fallback. See harness-picker-client.ts.
  initHarnessPicker();
</script>

<style>
  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .content {
    min-width: 0;
    flex: 1;
    padding: 2.5rem 0 5rem;
  }

  section {
    margin-bottom: 4rem;
    scroll-margin-top: 1.5rem;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin: 0 0 1rem;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--muted-fg);
    max-width: 40rem;
    margin: 0 0 1.75rem;
  }

  .cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 40rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.5rem;
    border: none;
    border-radius: 9999px;
    background: var(--accent);
    color: var(--accent-contrast);
    text-decoration: none;
    font-family: inherit;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
  }

  .cta-large {
    padding: 1.15rem 2.25rem;
    font-size: 1.2rem;
  }

  .cta:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  h2 {
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }

  .section-lede {
    color: var(--muted-fg);
    max-width: 40rem;
    margin: 0 0 1.5rem;
  }

  .harness-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .fine-print {
    margin: 0;
    color: var(--muted-fg);
    font-size: 0.85rem;
  }
</style>
