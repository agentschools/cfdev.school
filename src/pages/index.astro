---
import HarnessCard from "../components/HarnessCard.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { harnesses } from "../data/harnesses";

const outline = [
  { href: "#overview", label: "Overview" },
  { href: "#harnesses", label: "Supported harnesses" },
  { href: "#how-it-works", label: "How it works" },
  { href: "#enroll", label: "Enroll" },
];
---

<Layout
  title="Cloudflare Dev School"
  description="Learn to build on Cloudflare using whatever AI coding agent you already have installed. Free forever, no account required."
>
  <Header />

  <div class="page">
    <aside class="sidebar" aria-label="On this page">
      <nav>
        <ul>
          {
            outline.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>

    <main class="content">
      <section id="overview" class="hero">
        <h1>Cloudflare Dev School</h1>
        <p class="lede">
          Learn to build on Cloudflare using whatever AI coding agent you already have installed. No account, no
          email, no credit card. All you need to get started is a working AI coding agent on your computer. We'll
          walk you through setting up Cloudflare.
        </p>
        <div class="cta-block">
          <a class="cta" href="#enroll">Enroll in Cloudflare Dev School</a>
          <p class="fine-print">Free forever. No account required. No personal data collected.</p>
        </div>
      </section>

      <section id="harnesses" class="harnesses">
        <h2>Supported harnesses</h2>
        <p class="section-lede">
          Cloudflare Dev School works with these agent harnesses out of the box, plus a generic path for anything
          else. See <a href="https://developers.cloudflare.com/agent-setup/">Cloudflare's agent setup docs</a> for the
          latest official tooling recommendations.
        </p>
        <div class="harness-grid">
          {harnesses.map((harness) => <HarnessCard harness={harness} />)}
        </div>
      </section>

      <section id="how-it-works" class="how-it-works">
        <h2>How it works</h2>
        <ol>
          <li>Enroll and get a randomly generated student ID. No account needed.</li>
          <li>Pick your agent harness and copy the prompt we give you.</li>
          <li>Paste it into your agent. It'll interview you, then walk you through five short lessons: models, instructions, CLI, skills, and tools.</li>
          <li>Finish with one exercise: deploy your first Worker to your own Cloudflare account.</li>
        </ol>
      </section>

      <section id="enroll" class="enroll">
        <h2>Ready to start?</h2>
        <div class="cta-block">
          <a class="cta" href="#enroll">Enroll in Cloudflare Dev School</a>
          <p class="fine-print">Free forever. No account required. No personal data collected.</p>
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .page {
    display: flex;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    gap: 2.5rem;
  }

  .sidebar {
    display: none;
    flex-shrink: 0;
    width: 200px;
    padding-top: 2.5rem;
  }

  .sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    position: sticky;
    top: 2rem;
  }

  .sidebar a {
    text-decoration: none;
    color: var(--muted-fg);
    font-size: 0.9rem;
  }

  .sidebar a:hover {
    color: var(--fg);
  }

  .content {
    min-width: 0;
    flex: 1;
    padding: 2.5rem 0 5rem;
  }

  section {
    margin-bottom: 4rem;
    scroll-margin-top: 1.5rem;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin: 0 0 1rem;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--muted-fg);
    max-width: 40rem;
    margin: 0 0 1.75rem;
  }

  .cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 40rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.5rem;
    border-radius: 9999px;
    background: var(--accent);
    color: var(--accent-contrast);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
  }

  h2 {
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }

  .section-lede {
    color: var(--muted-fg);
    max-width: 40rem;
    margin: 0 0 1.5rem;
  }

  .harness-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .how-it-works ol {
    max-width: 40rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .fine-print {
    margin: 0;
    color: var(--muted-fg);
    font-size: 0.85rem;
  }

  @media (min-width: 900px) {
    .sidebar {
      display: block;
    }
  }
</style>
