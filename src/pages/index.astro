---
import AgentPrompt from "../components/AgentPrompt.astro";
import StudentIdCard from "../components/StudentIdCard.astro";
import Layout from "../layouts/Layout.astro";
import { harnesses } from "../data/harnesses";

// Rendered size (px) per mark, tuned by eye so the monochrome silhouettes read
// at the same visual weight. Falls back to a square for any harness added later.
const iconSize: Record<string, [number, number]> = {
  "claude-code": [44, 44],
  codex: [40, 40],
  opencode: [46, 46],
  pi: [36, 36],
  cursor: [38, 43],
  copilot: [44, 36],
};
const worksWith = harnesses.filter((harness) => harness.id !== "generic" && harness.icon);
---

<Layout
  title="Cloudflare Dev School"
  description="Learn to build on Cloudflare using whatever AI coding agent you already have installed. Free forever, no account required."
  minimalHeader
>
  <main class="hero" id="overview">
    <div class="hero-copy">
      <h1>You and your agent, ready for Cloudflare.</h1>
      <p class="lede">
        Learn the fundamentals of AI-powered development while setting up your favorite agent harness to work well
        with Cloudflare. Then start building for real.
      </p>
      <div class="cta-block" data-enroll-container>
        <button class="cta" type="button" data-enroll-trigger>Enroll — it takes 2 seconds</button>
        <p class="fine-print">Free forever. No account required.</p>
      </div>
      <AgentPrompt />
    </div>

    <div class="hero-visual">
      <StudentIdCard />
      <section id="harnesses" class="harnesses" aria-label="Works with">
        <p class="harnesses-label">Works with</p>
        <div class="harness-grid">
          {
            worksWith.map((harness) => {
              const [width, height] = iconSize[harness.id] ?? [40, 40];
              return (
                <span class="harness-cell" data-tooltip={harness.name} tabindex="0">
                  <span
                    class="harness-icon"
                    role="img"
                    aria-label={harness.name}
                    style={`width:${width}px;height:${height}px;--icon:url(${harness.icon!.mono})`}
                  />
                </span>
              );
            })
          }
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { buildPrompt } from "../lib/agent-prompt";
  import { type CachedStudent, ENROLLED_EVENT, readCachedStudent } from "../lib/enroll-client";
  import { initHarnessTooltips } from "../lib/harness-tooltip-client";

  initHarnessTooltips();

  // Same prompt for every student, once enrolled: the agent figures out its
  // own harness once it fetches /llms.txt, so there's no picker step here.
  function initAgentPrompt(): void {
    const promptSection = document.getElementById("agent-prompt");
    const promptText = document.getElementById("agent-prompt-text");
    const copyButton = document.getElementById("agent-prompt-copy") as HTMLButtonElement | null;
    const copyConfirm = document.getElementById("agent-prompt-confirm");
    if (!promptSection || !promptText || !copyButton || !copyConfirm) return;

    function showPrompt(student: CachedStudent): void {
      promptText!.textContent = buildPrompt(student);
      promptSection!.hidden = false;
      copyConfirm!.hidden = true;
    }

    copyButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(promptText!.textContent ?? "");
        copyConfirm!.hidden = false;
      } catch (error) {
        console.error("Copy failed", error);
      }
    });

    // initEnrollment() runs globally from Layout.astro, and Astro doesn't
    // guarantee it executes after this page-level script (in practice it runs
    // before), so the ENROLLED_EVENT dispatch for an already-cached student can
    // fire before the listener below is attached. Check directly as a fallback.
    document.addEventListener(ENROLLED_EVENT, ((event: CustomEvent<CachedStudent>) => showPrompt(event.detail)) as EventListener);
    const existingStudent = readCachedStudent();
    if (existingStudent) showPrompt(existingStudent);
  }

  initAgentPrompt();
</script>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 4rem;
    padding: 5.5rem 4rem;
    /* The celebration layer extends past the card; don't let it add a horizontal scrollbar on phones. */
    overflow-x: clip;
  }

  .hero-copy {
    flex: 1;
    min-width: 0;
  }

  .hero h1 {
    max-width: 5.6em;
    margin: 0 0 2rem;
    font-family: "Inter", system-ui, sans-serif;
    font-size: clamp(3rem, 5.2vw, 4.625rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .lede {
    max-width: 27.5rem;
    margin: 0 0 2.5rem;
    font-size: 1.25rem;
    line-height: 1.55;
    color: color-mix(in oklch, var(--fg) 80%, var(--bg));
  }

  .cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
  }

  .cta-block[hidden] {
    display: none;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    padding: 1.125rem 1.875rem;
    border: none;
    border-radius: 9999px;
    background: linear-gradient(180deg, #ff6b2e, #ff5e1f);
    color: #fff;
    font-family: inherit;
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.375rem;
    cursor: pointer;
  }

  .cta:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .fine-print {
    margin: 0;
    color: var(--muted-fg);
    font-size: 0.95rem;
  }

  .hero-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: flex-start;
    gap: 5.5rem;
    width: 26.25rem;
    max-width: 100%;
    margin: 0.5rem 4.5rem 0 0;
  }

  .harnesses {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.375rem;
  }

  .harnesses-label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in oklch, var(--fg) 35%, var(--bg));
  }

  .harness-grid {
    display: grid;
    grid-template-columns: repeat(3, 7.875rem);
    row-gap: 1.875rem;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .harness-grid:hover {
    opacity: 0.75;
  }

  .harness-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    cursor: default;
  }

  .harness-icon {
    display: block;
    flex-shrink: 0;
    background-color: var(--fg);
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }

  @media (max-width: 1180px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 4rem;
    }

    .hero-visual {
      align-self: center;
      margin: 0;
    }
  }

  @media (max-width: 700px) {
    .hero {
      padding: 4.5rem 1.5rem 3rem;
    }

    .harnesses,
    .harness-grid {
      width: 100%;
    }

    .harness-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<style is:global>
  /* Appended to <body> by harness-tooltip-client.ts, outside this page's
     scoped styles, so it needs to be global. */
  .harness-tooltip {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.3rem 0.6rem;
    border-radius: 0.35rem;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.1s ease;
    z-index: 20;
  }

  .harness-tooltip.is-visible {
    opacity: 1;
    visibility: visible;
  }
</style>
