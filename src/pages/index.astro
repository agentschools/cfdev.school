---
import StudentIdCard from "../components/StudentIdCard.astro";
import Layout from "../layouts/Layout.astro";
import { REQUIRED_COURSE, TRACK_LABELS, TRACKS } from "../data/courses";
import { harnesses } from "../data/harnesses";
import { catalogCourses, getBuiltInCourses } from "../lib/courses";
import type { HarnessDirectory } from "../lib/dashboard-client";

// Rendered size (px) per mark, tuned by eye so the monochrome silhouettes read
// at the same visual weight. Falls back to a square for any harness added later.
const iconSize: Record<string, [number, number]> = {
  "claude-code": [44, 44],
  codex: [40, 40],
  opencode: [46, 46],
  pi: [36, 36],
  cursor: [38, 43],
  copilot: [44, 36],
};
const worksWith = harnesses.filter((harness) => harness.id !== "generic" && harness.icon);

const courses = await getBuiltInCourses();
const catalog = catalogCourses(courses);
// The welcome's button: Agent setup's first exercise, its interview.
const interviewUrl = catalog.find((course) => course.name === REQUIRED_COURSE)?.exercises[0]?.url;
const harnessDirectory: HarnessDirectory = Object.fromEntries(
  harnesses.map((harness) => [
    harness.id,
    { name: harness.id === "generic" ? "Unknown agent" : harness.name, icon: harness.icon?.mono },
  ]),
);
// The choice offered once Agent setup is done: tracks with courses first.
const trackChoices = TRACKS.map((track) => ({
  track,
  ...TRACK_LABELS[track],
  hasCourses: courses.some((course) => course.track === track),
})).sort((a, b) => Number(b.hasCourses) - Number(a.hasCourses));
---

<Layout
  title="Cloudflare Dev School"
  description="Learn to build on Cloudflare using whatever AI coding agent you already have installed. Free forever, no account required."
  minimalHeader
>
  <!--
    The student ID only lives in localStorage, so the server always renders
    both the visitor hero and the enrolled dashboard. Mark the page enrolled
    before it paints, so returning students don't see the hero flash. The key
    matches STORAGE_KEY in src/lib/enroll-client.ts.
  -->
  <script is:inline>
    try {
      if (localStorage.getItem("cfDevSchool.student")) document.documentElement.dataset.enrolled = "";
    } catch {
      // localStorage blocked: show the visitor hero; enroll-client.ts handles the rest.
    }
  </script>
  <main class="hero" id="overview">
    <div class="hero-copy">
      <div class="visitor-only">
        <h1>You and your agent, ready for Cloudflare.</h1>
        <p class="lede">
          Learn the fundamentals of AI-powered development while setting up your favorite agent harness to work well
          with Cloudflare. Then start building for real.
        </p>
        <div class="cta-block" data-enroll-container>
          <button class="cta" type="button" data-enroll-trigger>Enroll — it takes 2 seconds</button>
          <p class="fine-print">Free forever. No account required.</p>
        </div>
      </div>

      <div
        id="dashboard"
        class="dashboard student-only"
        data-catalog={JSON.stringify(catalog)}
        data-harnesses={JSON.stringify(harnessDirectory)}
      >
        <section id="up-next" class="up-next" data-loading>
          <div id="up-next-welcome" hidden>
            <p class="eyebrow">You're enrolled</p>
            <h1 class="up-next-title">Welcome to Dev&nbsp;School.</h1>
            <p class="up-next-description">
              Your student ID is saved in this browser, and your agent uses it to keep track of your progress. No
              account, no email.
            </p>
            <div class="welcome-next">
              <p class="label">First up</p>
              <h2 class="welcome-next-title">A quick interview with your agent</h2>
              <p id="welcome-description" class="welcome-next-description"></p>
              <div class="welcome-start">
                <a class="welcome-cta" href={interviewUrl}>Start the interview →</a>
                <p class="welcome-start-note">Four questions. Your agent asks, you answer.</p>
              </div>
            </div>
          </div>
          <div id="up-next-exercise">
            <p id="up-next-eyebrow" class="eyebrow"></p>
            <h1 id="up-next-title" class="up-next-title"></h1>
            <p id="up-next-description" class="up-next-description"></p>
          </div>
          <div id="up-next-choose" hidden>
            <p id="choose-eyebrow" class="eyebrow">Agent setup complete</p>
            <h1 class="up-next-title">What's next?</h1>
            <p class="up-next-description">
              <span id="choose-lede">Your agent is ready for Cloudflare. </span>Pick a direction: build something, or
              learn the platform one piece at a time.
            </p>
            <div class="tracks">
              {
                trackChoices.map((choice) => {
                  const body = (
                    <>
                      <span class="track-label">{choice.title}</span>
                      <span class="track-pitch">{choice.pitch}</span>
                      <span class="track-description">{choice.description}</span>
                      <span class="track-start">{choice.hasCourses ? "Start →" : "Coming soon"}</span>
                    </>
                  );
                  return choice.hasCourses ? (
                    <a class="track is-available" href="/courses" data-track-start={choice.track}>
                      {body}
                    </a>
                  ) : (
                    <div class="track">{body}</div>
                  );
                })
              }
            </div>
            <p class="prompt-lead">Not sure? Paste this into your agent and it'll suggest a course based on your interview.</p>
          </div>
          <div id="dashboard-prompt" class="prompt">
            <pre id="dashboard-prompt-text" class="prompt-text"></pre>
            <button id="dashboard-prompt-copy" type="button" class="prompt-copy">Copy</button>
          </div>
          <p id="prompt-caption" class="prompt-caption">
            Paste this into your agent. It picks up where you left off. <a href="/agents">What's an agent?</a>
          </p>
        </section>

        <section id="your-courses" class="your-courses" aria-labelledby="your-courses-heading" hidden>
          <div class="section-head">
            <h2 id="your-courses-heading" class="label">Your courses</h2>
            <a href="/profile">All progress →</a>
          </div>
          <ol id="course-rows" class="course-rows"></ol>
        </section>
      </div>
    </div>

    <div class="hero-visual">
      <StudentIdCard />
      <section id="harnesses" class="harnesses visitor-only" aria-label="Works with">
        <a class="harnesses-label" href="/agents">Works with</a>
        <div class="harness-grid">
          {
            worksWith.map((harness) => {
              const [width, height] = iconSize[harness.id] ?? [40, 40];
              return (
                <span class="harness-cell" data-tooltip={harness.name} tabindex="0">
                  <span
                    class="harness-icon"
                    role="img"
                    aria-label={harness.name}
                    style={`width:${width}px;height:${height}px;--icon:url(${harness.icon!.mono})`}
                  />
                </span>
              );
            })
          }
        </div>
      </section>
      <section id="about-you" class="side-section student-only" hidden>
        <h2 class="label">About you</h2>
        <p id="about-you-summary" class="about-you-summary"></p>
        <p class="side-note">From your Agent setup interview. Tell your agent to change any answer.</p>
      </section>
      <section id="your-agents" class="side-section student-only" hidden>
        <h2 class="label">Your agents</h2>
        <ul id="agent-list" class="agent-list"></ul>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { initDashboard } from "../lib/dashboard-client";
  import { initHarnessTooltips } from "../lib/harness-tooltip-client";

  initHarnessTooltips();
  initDashboard();
</script>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 4rem;
    /* Wide enough for the copy and the card side by side at laptop widths;
       on wider screens the pair stays together, centered, instead of
       drifting to opposite edges. */
    max-width: 76rem;
    margin: 0 auto;
    padding: 5.5rem 4rem;
    /* The celebration layer extends past the card; don't let it add a horizontal scrollbar on phones. */
    overflow-x: clip;
  }

  .hero-copy {
    flex: 1;
    min-width: 0;
  }

  .visitor-only h1 {
    max-width: 5.6em;
    margin: 0 0 2rem;
    font-family: "Inter", system-ui, sans-serif;
    font-size: clamp(3rem, 5.2vw, 4.625rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .lede {
    max-width: 27.5rem;
    margin: 0 0 2.5rem;
    font-size: 1.25rem;
    line-height: 1.55;
    color: color-mix(in oklch, var(--fg) 80%, var(--bg));
  }

  .cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
  }

  .cta-block[hidden] {
    display: none;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    padding: 1.125rem 1.875rem;
    border: none;
    border-radius: 9999px;
    background: linear-gradient(180deg, var(--accent), var(--accent-hover));
    color: #fff;
    font-family: inherit;
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.375rem;
    cursor: pointer;
  }

  .cta:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Set by enroll-client.ts while a fresh ID is revealed: the CTA fades out
     (without collapsing, so the card doesn't shift where it stacks below the
     copy) and the rest of the hero dims around the card. */
  .hero-copy .visitor-only > :global(*),
  .harnesses {
    transition:
      opacity 0.4s ease,
      visibility 0.4s;
  }

  :global(:root[data-minting]) .hero-copy .visitor-only > :global(*),
  :global(:root[data-minting]) .harnesses {
    opacity: 0.25;
  }

  :global(:root[data-minting]) .hero-copy .visitor-only > .cta-block {
    opacity: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy .visitor-only > :global(*),
    .harnesses {
      transition: none;
    }
  }

  .fine-print {
    margin: 0;
    color: var(--muted-fg);
    font-size: 0.95rem;
  }

  .hero-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: flex-start;
    gap: 5.5rem;
    width: 26.25rem;
    max-width: 100%;
    margin: 0.5rem 4.5rem 0 0;
  }

  .harnesses {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.375rem;
  }

  .harnesses-label {
    margin: 0;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in oklch, var(--fg) 35%, var(--bg));
  }

  .harness-grid {
    display: grid;
    grid-template-columns: repeat(3, 7.875rem);
    row-gap: 1.875rem;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .harness-grid:hover {
    opacity: 0.75;
  }

  .harness-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    cursor: default;
  }

  .harness-icon {
    display: block;
    flex-shrink: 0;
    background-color: var(--fg);
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }

  @media (max-width: 1180px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 4rem;
    }

    .hero-visual {
      align-self: center;
      margin: 0;
    }
  }

  @media (max-width: 700px) {
    .hero {
      padding: 4.5rem 1.5rem 3rem;
    }

    .harnesses,
    .harness-grid {
      width: 100%;
    }

    .harness-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Visitor hero vs. enrolled dashboard. The inline script at the top of the
     page sets data-enrolled before first paint; dashboard-client.ts sets it on
     a fresh enrollment, switching the page over right away. */
  :global(:root[data-enrolled]) .visitor-only,
  :global(:root:not([data-enrolled])) .student-only {
    display: none;
  }

  :global(:root[data-enrolled]) .hero {
    align-items: flex-start;
    gap: 4.5rem;
    padding: 4.5rem 5rem 5rem;
  }

  :global(:root[data-enrolled]) .hero-copy {
    max-width: 38.75rem;
  }

  :global(:root[data-enrolled]) .hero-visual {
    align-items: stretch;
    gap: 3rem;
    width: 21.25rem;
    margin: 0;
  }

  :global(:root[data-enrolled]) .hero-visual :global(.id-card) {
    width: min(21.25rem, 100%);
  }

  :global(:root[data-enrolled]) .hero-visual :global(.id-card-face) {
    rotate: -3deg;
    padding: 1.5rem 1.625rem;
  }

  :global(:root[data-enrolled]) .hero-visual :global(.id-card-label) {
    font-size: 0.6875rem;
  }

  .dashboard {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .dashboard [hidden] {
    display: none;
  }

  /* Filled in from live progress; don't show placeholder content before it arrives. */
  .up-next[data-loading] {
    visibility: hidden;
  }

  .eyebrow,
  .label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow {
    color: var(--accent-text);
  }

  .label {
    color: var(--muted-fg);
  }

  .up-next-title {
    margin: 0.875rem 0 0;
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .up-next-description {
    max-width: 32.5rem;
    margin: 1rem 0 0;
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: color-mix(in oklch, var(--fg) 80%, var(--bg));
  }

  .welcome-next {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .welcome-next-title {
    margin: 0.625rem 0 0;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 2.125rem;
    letter-spacing: -0.02em;
  }

  .welcome-next-description {
    max-width: 33.75rem;
    margin: 0.625rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6875rem;
    color: color-mix(in oklch, var(--fg) 80%, var(--bg));
  }

  .welcome-start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 2rem;
  }

  .welcome-cta {
    display: inline-flex;
    padding: 0.875rem 1.5rem;
    border-radius: 9999px;
    background: linear-gradient(180deg, var(--accent), var(--accent-hover));
    color: #fff;
    font-weight: 600;
    line-height: 1.375rem;
    text-decoration: none;
  }

  .welcome-cta:hover {
    filter: brightness(1.08);
  }

  .welcome-start-note {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted-fg);
  }

  .tracks {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }

  .track {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.875rem;
    color: inherit;
    text-decoration: none;
  }

  .track.is-available {
    border: 1.5px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg));
  }

  .track.is-available:hover {
    background: color-mix(in srgb, var(--accent) 14%, var(--bg));
  }

  .track-label {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-fg);
  }

  .is-available .track-label,
  .is-available .track-start {
    color: var(--accent-text);
  }

  .track-pitch {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.875rem;
    letter-spacing: -0.02em;
  }

  .track-description {
    font-size: 0.9375rem;
    line-height: 1.375rem;
    color: color-mix(in oklch, var(--fg) 80%, var(--bg));
  }

  .track-start {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.375rem;
    color: var(--muted-fg);
  }

  .is-available .track-start {
    font-weight: 600;
  }

  .prompt-lead {
    margin: 1.75rem 0 0;
    max-width: none;
    font-size: 0.875rem;
    color: color-mix(in oklch, var(--fg) 80%, var(--bg));
  }

  .prompt {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-top: 2rem;
    padding: 1.375rem 1.25rem 1.375rem 1.5rem;
    border: 1px solid light-dark(transparent, #34302e);
    border-radius: 0.875rem;
    background: light-dark(#171717, #1e1c1b);
  }

  /* The "Not sure?" line sits just above the prompt. */
  #up-next-choose:not([hidden]) + .prompt {
    margin-top: 0.75rem;
  }

  .prompt-text {
    flex: 1;
    min-width: 0;
    margin: 0;
    white-space: pre-wrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.8125rem;
    line-height: 1.3125rem;
    color: light-dark(#f5f5f5, #efe6e1);
  }

  .prompt-copy {
    flex-shrink: 0;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 9999px;
    background: linear-gradient(180deg, var(--accent), var(--accent-hover));
    color: #fff;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25rem;
    cursor: pointer;
  }

  .prompt-copy:hover {
    filter: brightness(1.08);
  }

  .prompt-caption {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--muted-fg);
  }

  .prompt-caption a {
    color: var(--accent-text);
    text-decoration: none;
  }

  .prompt-caption a:hover,
  .harnesses-label:hover {
    text-decoration: underline;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid light-dark(var(--fg), #4a4544);
  }

  .section-head .label {
    color: var(--fg);
  }

  .section-head a {
    font-size: 0.875rem;
    color: var(--accent-text);
    text-decoration: none;
  }

  .course-rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Rows and agents are rendered by dashboard-client.ts, so they need :global(). */
  .course-rows :global(li + li) {
    border-top: 1px solid var(--border);
  }

  .course-rows :global(.course-group) {
    padding: 1.25rem 0 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-fg);
  }

  .course-rows :global(li + .course-group),
  .course-rows :global(.course-group + li) {
    border-top: none;
  }

  .course-rows :global(.course-row) {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.125rem 0;
    color: inherit;
    text-decoration: none;
  }

  .course-rows :global(.course-row:hover .course-row-title) {
    color: var(--accent-text);
  }

  .course-rows :global(.course-row-text) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    width: 12.5rem;
    flex-shrink: 0;
  }

  .course-rows :global(.course-row-title) {
    font-weight: 600;
    line-height: 1.375rem;
  }

  .course-rows :global(.course-row-sub) {
    font-size: 0.8125rem;
    line-height: 1.125rem;
    color: var(--muted-fg);
  }

  .course-rows :global(.course-row-bar) {
    flex: 1;
    display: flex;
    gap: 0.25rem;
  }

  .course-rows :global(.course-row-bar span) {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--border);
  }

  .course-rows :global(.course-row-bar span.is-done) {
    background: var(--accent);
  }

  .course-rows :global(.course-row-count) {
    width: 3.5rem;
    flex-shrink: 0;
    text-align: right;
    font-size: 0.875rem;
    color: color-mix(in oklch, var(--fg) 80%, var(--bg));
    font-variant-numeric: tabular-nums;
  }

  .side-section {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .side-section[hidden] {
    display: none;
  }

  .about-you-summary {
    margin: 0;
    line-height: 1.5rem;
  }

  .side-note {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.125rem;
    color: var(--muted-fg);
  }

  .agent-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0.125rem 0 0;
    padding: 0;
    list-style: none;
  }

  .agent-list :global(li) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .agent-list :global(.agent-icon) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--card-bg);
  }

  .agent-list :global(.agent-mark) {
    width: 1.125rem;
    height: 1.125rem;
    background-color: var(--fg);
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }

  .agent-list :global(.agent-text) {
    display: flex;
    flex-direction: column;
  }

  .agent-list :global(.agent-name) {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25rem;
  }

  .agent-list :global(.agent-count) {
    font-size: 0.8125rem;
    line-height: 1.125rem;
    color: var(--muted-fg);
  }

  @media (max-width: 1180px) {
    :global(:root[data-enrolled]) .hero-copy {
      max-width: none;
      width: 100%;
    }

    :global(:root[data-enrolled]) .hero-visual {
      align-self: stretch;
      width: auto;
      max-width: 21.25rem;
    }
  }

  @media (max-width: 700px) {
