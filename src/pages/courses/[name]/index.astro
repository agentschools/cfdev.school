---
import { render } from "astro:content";
import AgentPrompt from "../../../components/AgentPrompt.astro";
import EnrollBanner from "../../../components/EnrollBanner.astro";
import Layout from "../../../layouts/Layout.astro";
import { exercisePath } from "../../../data/courses";
import { getBuiltInCourse } from "../../../lib/courses";

export const prerender = false;

const course = await getBuiltInCourse(Astro.params.name ?? "");

if (!course) {
  Astro.response.status = 404;
}

const Content = course ? (await render(course.entry)).Content : null;
const title = course?.title ?? "Course not found";
---

<Layout title={`${title} — Cloudflare Dev School`} description={course?.description ?? "Course not found."}>
  <div class="page">
    {
      !course || !Content ? (
        <main class="content">
          <p>This course doesn't exist.</p>
        </main>
      ) : (
        <main class="content" data-course-page data-course-name={course.name} data-course-title={course.title}>
          <header class="header">
            <p class="eyebrow">
              <a href="/courses">Courses</a>
            </p>
            <h1>{title}</h1>
            <p class="description">{course.description}</p>
          </header>

          <EnrollBanner id="course-enroll-nudge" />

          <div class="prose">
            <Content />
          </div>

          <h2 class="exercises-heading">Exercises</h2>
          <ol class="exercise-list">
            {course.exercises.map((exercise, index) => (
              <li data-course={course.name} data-exercise={exercise.slug}>
                <span class="index">{String(index).padStart(2, "0")}.</span>
                <span>
                  <a href={exercisePath(course.name, exercise.slug)}>{exercise.title}</a>
                  {exercise.description && <span class="exercise-description">: {exercise.description}</span>}
                  <span class="check" hidden aria-label="Completed">
                    ✓
                  </span>
                </span>
              </li>
            ))}
          </ol>

          <div class="prompt">
            <AgentPrompt />
          </div>
        </main>
      )
    }
  </div>
</Layout>

<script>
  import { initCoursePage } from "../../../lib/course-client";
  initCoursePage();
</script>

<style>
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    container-type: inline-size;
  }

  .content {
    padding: 2.5rem 0 5rem;
    max-width: 42rem;
  }

  /* A course intro's video breaks out of the text column to the page's full width. */
  .prose :global(figure:has(video)) {
    width: 100cqw;
  }

  .prose :global(.course-header-artwork img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  .header {
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.04em;
    color: var(--muted-fg);
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--fg);
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 0.75rem;
  }

  .description {
    color: var(--muted-fg);
    font-size: 1.1rem;
    margin: 0;
  }

  .prompt {
    margin-top: 2.5rem;
  }

  .exercise-list li[data-next] .index {
    color: var(--accent-text);
  }

  .exercises-heading {
    font-size: 1.35rem;
    margin: 2rem 0 0.75rem;
  }

  .exercise-list {
    list-style: none;
    margin: 0;
    padding: 0;
    line-height: 1.5;
  }

  .exercise-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
  }

  .exercise-list li:first-child {
    padding-top: 0;
  }

  .exercise-list li:last-child {
    border-bottom: none;
  }

  .index {
    color: color-mix(in oklch, var(--fg) 35%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .exercise-list a {
    font-weight: 600;
    color: var(--accent-text);
  }

  .check {
    color: var(--accent-text);
    font-weight: 700;
    margin-left: 0.35rem;
  }

  .check[hidden] {
    display: none;
  }

  .exercise-description {
    color: var(--muted-fg);
  }
</style>
