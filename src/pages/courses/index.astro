---
import Layout from "../../layouts/Layout.astro";
import { coursePath, REQUIRED_COURSE, TRACK_LABELS, TRACKS } from "../../data/courses";
import { getBuiltInCourses } from "../../lib/courses";

export const prerender = false;

const courses = await getBuiltInCourses();
// Agent setup on its own, then each track's courses.
const groups = [
  { id: "start", title: undefined, description: undefined, courses: courses.filter((course) => !course.track) },
  ...TRACKS.map((track) => ({ id: track, ...TRACK_LABELS[track], courses: courses.filter((c) => c.track === track) })),
];
---

<Layout
  title="Courses — Cloudflare Dev School"
  description="Courses that teach you to build on Cloudflare with your AI coding agent. Start with Agent setup."
>
  <div class="page">
    <main class="content">
      <h1>Courses</h1>
      <p class="lede">
        Each course is a short series of exercises your agent walks you through. Start with Agent setup, every other
        course assumes you've finished it. Then pick a project to build, or learn the fundamentals one at a time. Projects
        never require a fundamentals course.
      </p>

      {
        groups.map((group) => (
          <section class="group" data-group={group.id}>
            {group.title && (
              <>
                <h2>{group.title}</h2>
                <p class="group-description">{group.description}</p>
              </>
            )}
            {group.courses.length === 0 ? (
              <p class="coming-soon">Coming soon.</p>
            ) : (
              <ol class="course-list">
                {group.courses.map((course) => (
                  <li data-course-name={course.name}>
                    <a href={coursePath(course.name)}>
                      {course.name === REQUIRED_COURSE && <span class="order">Start here</span>}
                      <span class="title">{course.title}</span>
                      <span class="description">{course.description}</span>
                      <span class="count">{course.exercises.length} exercises</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </section>
        ))
      }

      <p class="authors">Know something worth teaching? <a href="/authors">Write a course</a> and host it anywhere.</p>
    </main>
  </div>
</Layout>

<style>
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .content {
    padding: 2.5rem 0 5rem;
    max-width: 42rem;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 0.75rem;
  }

  .lede {
    margin: 0 0 2rem;
    color: var(--muted-fg);
    font-size: 1.1rem;
  }

  .group + .group {
    margin-top: 2.5rem;
  }

  h2 {
    font-size: 1.35rem;
    margin: 0 0 0.25rem;
  }

  .group-description,
  .coming-soon {
    margin: 0 0 1rem;
    color: var(--muted-fg);
  }

  .course-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .course-list a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--card-bg);
    text-decoration: none;
    color: inherit;
  }

  .course-list a:hover {
    border-color: var(--accent-text);
  }

  .order {
    font-size: 0.75rem;
    font-weight: 600;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.04em;
    color: var(--muted-fg);
    text-transform: uppercase;
  }

  .title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .description {
    color: var(--muted-fg);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .count {
    font-size: 0.85rem;
    color: var(--muted-fg);
  }

  .authors {
    margin: 2rem 0 0;
    color: var(--muted-fg);
  }

  .authors a {
    color: var(--accent-text);
  }
</style>
