---
import Layout from "../../layouts/Layout.astro";
import { coursePath, REQUIRED_COURSE } from "../../data/courses";
import { getBuiltInCourses } from "../../lib/courses";

export const prerender = false;

const courses = await getBuiltInCourses();
---

<Layout
  title="Courses — Cloudflare Dev School"
  description="Courses that teach you to build on Cloudflare with your AI coding agent. Start with Agent setup."
>
  <div class="page">
    <main class="content">
      <h1>Courses</h1>
      <p class="lede">
        Each course is a short series of exercises your agent walks you through. Start with Agent setup, every other
        course assumes you've finished it.
      </p>

      <ol class="course-list">
        {
          courses.map((course, index) => (
            <li data-course-name={course.name}>
              <a href={coursePath(course.name)}>
                <span class="order">
                  Course {index + 1}
                  {course.name === REQUIRED_COURSE && " · Start here"}
                </span>
                <span class="title">{course.title}</span>
                <span class="description">{course.description}</span>
                <span class="count">{course.exercises.length} exercises</span>
              </a>
            </li>
          ))
        }
      </ol>
    </main>
  </div>
</Layout>

<style>
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .content {
    padding: 2.5rem 0 5rem;
    max-width: 42rem;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 0.75rem;
  }

  .lede {
    margin: 0 0 2rem;
    color: var(--muted-fg);
    font-size: 1.1rem;
  }

  .course-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .course-list a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--card-bg);
    text-decoration: none;
    color: inherit;
  }

  .course-list a:hover {
    border-color: var(--accent);
  }

  .order {
    font-size: 0.75rem;
    font-weight: 600;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.04em;
    color: var(--muted-fg);
    text-transform: uppercase;
  }

  .title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .description {
    color: var(--muted-fg);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .count {
    font-size: 0.85rem;
    color: var(--muted-fg);
  }
</style>
