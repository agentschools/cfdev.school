---
import { getCollection, render } from "astro:content";
import AgentPrompt from "../../components/AgentPrompt.astro";
import Layout from "../../layouts/Layout.astro";
import { harnesses } from "../../data/harnesses";

export const prerender = false;

const { slug } = Astro.params;
const entries = await getCollection(
  "lessons",
  (entry) => entry.data.lessonSlug === slug && entry.data.harness === "generic",
);

// The harness-specific variants (e.g. claude-code.md) exist only for the
// /api/lessons/{slug} endpoint, which agents call with their own detected
// harness. Human visitors to this page always see the generic content:
// there's no harness picker to tell us which variant they'd want.
const entry = entries[0];

if (!entry) {
  Astro.response.status = 404;
}

const lesson = entry
  ? {
      title: entry.data.title,
      description: entry.data.description,
      order: entry.data.order,
      Content: (await render(entry)).Content,
    }
  : null;

// Where the "next" button points once this lesson is complete: the next
// lesson that has content, or the exercises after the last one.
const lessonsInOrder = (await getCollection("lessons", (item) => item.data.harness === "generic"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((item) => ({ slug: item.data.lessonSlug, title: item.data.title }));
const nextLesson = lessonsInOrder[lessonsInOrder.findIndex((item) => item.slug === slug) + 1];
const next = nextLesson
  ? { url: `/lessons/${nextLesson.slug}`, label: `Next lesson: ${nextLesson.title} →`, shortLabel: `Next: ${nextLesson.title} →` }
  : { url: "/exercises", label: "Next up: Exercises →", shortLabel: "Next: Exercises →" };

// How the completed banner names each agent ("...using Claude Code").
const harnessNames = Object.fromEntries(
  harnesses.map((harness) => [harness.id, harness.id === "generic" ? "an unknown agent" : harness.name]),
);

const title = lesson?.title ?? "Lesson not found";
---

<Layout title={`${title} — Cloudflare Dev School`} description={lesson?.description ?? "Lesson not found."}>
  <div class="page">
    <main class="content">
      {
        lesson === null ? (
          <p>This lesson doesn't exist.</p>
        ) : (
          <>
            <header class="header">
              <p class="eyebrow">Lesson {lesson.order}</p>
              <h1>{title}</h1>
              <p class="lesson-description">{lesson.description}</p>
            </header>

            <div
              id="lesson-completed-banner"
              class="completed-banner"
              data-harness-names={JSON.stringify(harnessNames)}
              hidden
            >
              <div class="completed-body">
                <span id="lesson-completed-text">You completed this lesson!</span>
                <p id="lesson-completed-summary" class="completed-summary" hidden></p>
              </div>
              <a class="completed-next" href={next.url}>{next.shortLabel}</a>
            </div>

            <div id="lesson-enroll-nudge" class="enroll-nudge" hidden>
              <a href="/">Enroll for free</a> to track your progress through the course.
            </div>

            <AgentPrompt />

            <div class="prose">
              <lesson.Content />
            </div>

            <div id="lesson-next" class="lesson-next" hidden>
              <p id="lesson-next-pending" class="lesson-next-pending">
                Complete this lesson in your agent to continue.
              </p>
              <a id="lesson-next-link" class="lesson-next-link" href={next.url} hidden>
                {next.label}
              </a>
            </div>
          </>
        )
      }
    </main>
  </div>
</Layout>

<script>
  import { initLessonPage } from "../../lib/lesson-client";
  import { initCodeCopyButtons } from "../../lib/code-copy-client";
  initLessonPage();
  initCodeCopyButtons();
</script>

<style>
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .content {
    padding: 2.5rem 0 5rem;
    max-width: 42rem;
  }

  .header {
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.04em;
    color: var(--muted-fg);
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 0.75rem;
  }

  .lesson-description {
    color: var(--muted-fg);
    font-size: 1.1rem;
    margin: 0;
  }

  .completed-banner {
    margin: 0 0 1.5rem;
    padding: 0.85rem 1rem;
    border-radius: 0.6rem;
    background: color-mix(in oklch, var(--accent) 12%, transparent);
    color: var(--accent);
    font-size: 0.95rem;
    font-weight: 600;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }

  .completed-banner[hidden] {
    display: none;
  }

  .completed-body {
    flex: 1 1 18rem;
  }

  .completed-next {
    flex-shrink: 0;
    padding: 0.45rem 0.85rem;
    border-radius: 0.45rem;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .completed-next:hover {
    filter: brightness(1.05);
  }

  .completed-summary {
    margin: 0.35rem 0 0;
    color: var(--fg);
    font-weight: 400;
    line-height: 1.5;
  }

  .completed-summary[hidden] {
    display: none;
  }

  .enroll-nudge {
    margin: 0 0 2rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    color: var(--muted-fg);
    font-size: 0.95rem;
  }

  .enroll-nudge a {
    color: var(--accent);
    font-weight: 600;
  }

  .lesson-next {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .lesson-next-pending {
    margin: 0;
    text-align: center;
    color: var(--muted-fg);
    font-size: 0.9rem;
  }

  .lesson-next-link {
    display: flex;
    justify-content: center;
    padding: 1rem 1.5rem;
    border-radius: 0.6rem;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .lesson-next-link:hover {
    filter: brightness(1.05);
  }

  .lesson-next [hidden] {
    display: none;
  }

  .prose {
    line-height: 1.7;
  }

  .prose :global(h2) {
    font-size: 1.35rem;
    margin: 2rem 0 0.75rem;
  }

  .prose :global(p) {
    margin: 0 0 1rem;
  }

  .prose :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }

  .prose :global(a) {
    color: var(--accent);
  }

  .prose :global(pre) {
    margin: 0 0 1rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--card-bg);
    color: var(--fg);
    white-space: pre-wrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    font-size: inherit;
  }

  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
  }

</style>
