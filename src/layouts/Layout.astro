---
import CurriculumSidebar from "../components/CurriculumSidebar.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  showSidebarBrand?: boolean;
  minimalHeader?: boolean;
}

const { title, description, showSidebarBrand = true, minimalHeader = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@800&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <CurriculumSidebar showBrand={showSidebarBrand} />
      <div class="site-main">
        <Header minimal={minimalHeader} />
        <slot />
      </div>
    </div>
    <script>
      import { initEnrollment } from "../lib/enroll-client";
      // Runs on every page so [data-enroll-trigger] elements anywhere (e.g. the
      // header's button) reflect enrolled state. Despite this tag being placed
      // after <slot /> in the source, Astro hoists it ahead of page-level
      // scripts in the rendered HTML, so it actually runs BEFORE e.g. the
      // homepage's initAgentPrompt(). Anything that needs to react to an
      // already-cached student can't rely on script order or solely on the
      // ENROLLED_EVENT this dispatches — check readCachedStudent() directly too
      // (see src/pages/index.astro for an example).
      initEnrollment();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;

    /* Cloudflare brand accent, measured from developers.cloudflare.com. Same in both themes. */
    --accent: oklch(0.687 0.208 38.8);
    --accent-contrast: oklch(0.99 0.009 78.3);

    /* Light theme, measured from developers.cloudflare.com. */
    --bg: oklch(0.99 0 0);
    --fg: oklch(0.21 0 0);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      /* Dark theme, measured from developers.cloudflare.com. */
      --bg: oklch(0.192 0 0);
      --fg: oklch(0.925 0.016 42.4);
    }
  }

  :root {
    --muted-fg: color-mix(in oklch, var(--fg) 65%, transparent);
    --border: color-mix(in oklch, var(--fg) 14%, transparent);
    --card-bg: color-mix(in oklch, var(--fg) 4%, var(--bg));
    /* Heading font: the OS-native system font stack at a heavy weight with tight
       tracking, the same look as https://freeretro.ziki.workers.dev/'s "Free
       Retro" wordmark (which is plain system-ui at font-weight 900, not a
       custom webfont). Body copy stays on Inter for readability. */
    --heading-font: -apple-system, system-ui, "Segoe UI", Roboto, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family:
      "Inter",
      system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      sans-serif;
    line-height: 1.5;
  }

  a {
    color: inherit;
  }

  h1,
  h2,
  h3 {
    font-family: var(--heading-font);
    letter-spacing: -0.03em;
  }

  h1 {
    font-weight: 900;
  }

  h2,
  h3 {
    font-weight: 800;
  }

  .site-shell {
    display: flex;
    min-height: 100vh;
  }

  .site-main {
    position: relative;
    min-width: 0;
    flex: 1;
  }

  .code-block {
    position: relative;
    margin: 0 0 1rem;
  }

  .code-block > pre {
    margin: 0 !important;
    padding-right: 3rem !important;
  }

  .code-copy {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem;
    border: 1px solid transparent;
    border-radius: 0.4rem;
    background: transparent;
    color: var(--muted-fg);
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .code-copy:hover,
  .code-copy:focus-visible {
    border-color: var(--border);
    background: var(--bg);
    color: var(--fg);
  }

  .code-copy.copied {
    padding-right: 0.6rem;
    border-color: var(--border);
    background: var(--bg);
    color: var(--fg);
  }
</style>
