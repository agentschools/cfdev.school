---
import { themeColors } from "../lib/theme";
---

<div class="color-selector" data-color-selector>
  <fieldset>
    <legend>Choose your color</legend>
    <p>For your student ID and the whole school. <span data-color-label>School orange (default)</span></p>
    <div class="swatches">
      {themeColors.map((theme) => (
        <label class="color-option" title={theme.label} style={`--swatch:${theme.solid}`}>
          <input type="radio" name="student-color" value={theme.name} aria-label={theme.label} />
          <span class="swatch" aria-hidden="true"><span class="selected-check">✓</span></span>
        </label>
      ))}
    </div>
    <button class="reset-color" type="button" data-default-color aria-pressed="true">Use school orange</button>
  </fieldset>
</div>

<style>
  .color-selector {
    max-width: 24rem;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
  }

  legend {
    padding: 0 0.35rem;
    font-weight: 600;
  }

  p {
    margin: 0 0 1rem;
    color: var(--muted-fg);
    font-size: 0.875rem;
  }

  [data-color-label] {
    display: block;
    margin-top: 0.25rem;
    color: var(--fg);
  }

  .reset-color {
    margin-top: 1rem;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }

  .reset-color:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
  }

  .color-option {
    position: relative;
    display: grid;
    min-width: 0;
    height: 2.75rem;
    cursor: pointer;
  }

  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .swatch {
    display: grid;
    place-items: center;
    border-radius: 0.5rem;
    background: var(--swatch);
    color: #fff;
    border: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
    pointer-events: none;
  }

  .selected-check {
    visibility: hidden;
    font-size: 1.2rem;
    font-weight: 700;
  }

  input:checked + .swatch {
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--fg);
  }

  input:checked + .swatch .selected-check {
    visibility: visible;
  }

  input:focus-visible + .swatch {
    outline: 3px dashed var(--fg);
    outline-offset: 3px;
  }

</style>
