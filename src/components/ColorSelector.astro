---
import { DEFAULT_THEME, themeColors } from "../lib/theme";
---

<details class="color-selector" data-color-selector>
  <summary><span class="current-swatch" aria-hidden="true"></span>Color<span class="current-color" data-color-label>: Orange</span></summary>
  <fieldset>
    <legend>Choose your color</legend>
    <p>For your student ID and the whole school.</p>
    <div class="swatches">
      {themeColors.map((theme) => (
        <label class="color-option" title={theme.label} style={`--swatch:${theme.solid}`}>
          <input type="radio" name="student-color" value={theme.name} aria-label={theme.label} checked={theme.name === DEFAULT_THEME} />
          <span class="swatch" aria-hidden="true"><span class="selected-check">✓</span></span>
        </label>
      ))}
    </div>
  </fieldset>
</details>

<script>
  import { initColorSelector } from "../lib/theme-client";
  initColorSelector();
</script>

<style>
  .color-selector {
    position: relative;
    font-size: 0.875rem;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.5rem;
    border-radius: 0.4rem;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    background: var(--card-bg);
  }

  summary:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
  }

  .current-swatch {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--accent);
    border: 1px solid var(--accent-text);
  }

  .current-color {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  fieldset {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    z-index: 10;
    width: min(19rem, calc(100vw - 2rem));
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.15);
  }

  legend {
    float: left;
    width: 100%;
    padding: 0;
    font-weight: 600;
  }

  p {
    clear: both;
    margin: 0 0 0.8rem;
    color: var(--muted-fg);
    font-size: 0.75rem;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
  }

  .color-option {
    position: relative;
    display: grid;
    min-width: 0;
    height: 2.75rem;
    cursor: pointer;
  }

  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .swatch {
    display: grid;
    place-items: center;
    border-radius: 0.5rem;
    background: var(--swatch);
    color: #fff;
    border: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
    pointer-events: none;
  }

  .selected-check {
    visibility: hidden;
    font-size: 1.2rem;
    font-weight: 700;
  }

  input:checked + .swatch {
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--fg);
  }

  input:checked + .swatch .selected-check {
    visibility: visible;
  }

  input:focus-visible + .swatch {
    outline: 3px dashed var(--fg);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    fieldset {
      position: fixed;
      top: 4.5rem;
      left: 1rem;
      right: 1rem;
      width: auto;
      max-height: calc(100dvh - 6rem);
      overflow-y: auto;
    }
  }
</style>
