---
import type { HarnessProfile } from "../data/harnesses";

interface Props {
  harness: HarnessProfile;
}

const { harness } = Astro.props;
---

<article class="card">
  <h3>{harness.name}</h3>
  {harness.cliCommand && <code class="cli">{harness.cliCommand}</code>}
  <p>{harness.tagline}</p>
</article>

<style>
  .card {
    border: 1px solid var(--border);
    background: var(--card-bg);
    border-radius: 0.75rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .cli {
    align-self: flex-start;
    font-size: 0.8rem;
    padding: 0.15rem 0.5rem;
    border-radius: 0.35rem;
    background: color-mix(in oklch, var(--fg) 8%, transparent);
  }

  .card p {
    margin: 0;
    color: var(--muted-fg);
    font-size: 0.85rem;
    line-height: 1.5;
  }
</style>
