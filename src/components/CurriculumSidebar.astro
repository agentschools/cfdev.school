---
import { coursePath, exercisePath } from "../data/courses";
import { getBuiltInCourses } from "../lib/courses";

interface Props {
  showBrand?: boolean;
}

const { showBrand = true } = Astro.props;

const courses = await getBuiltInCourses();
const currentPath = Astro.url.pathname.replace(/\/$/, "");

// MOCKUP (explore/sidebar-tracks): fake Projects and Fundamentals tracks.
// Courses with a `name` are real; the rest link nowhere.
const VISIBLE_PER_TRACK = 5;
const tracks: { label: string; courses: { title: string; name?: string }[] }[] = [
  {
    label: "Projects",
    courses: [
      { title: "Publish a website" },
      { title: "Build an AI agent" },
      { title: "Create a multiplayer game" },
      { title: "Achieve inbox zero" },
      { title: "Get a daily digest" },
      { title: "Chat with your documents" },
      { title: "Make a link shortener" },
      { title: "Host a photo gallery" },
    ],
  },
  {
    label: "Fundamentals",
    courses: [
      { title: "Workers", name: "workers-basics" },
      { title: "Bindings" },
      { title: "Durable Objects" },
      { title: "Storage" },
      { title: "AI" },
      { title: "How Cloudflare works" },
      { title: "Async work" },
      { title: "Security at the edge" },
    ],
  },
];
const byName = new Map(courses.map((course) => [course.name, course]));
const agentSetup = courses[0]!;
---

<nav class="curriculum-sidebar" aria-label="Course curriculum">
  {
    showBrand && (
      <a class="brand" href="/">
        <svg class="brand-logo" width="40" height="18" viewBox="-2 -2 345 160" aria-hidden="true">
          <path
            fill="#FF9910"
            d="M275.125 68.25C311.507 68.25 341 97.9335 341 134.55C341 141.077 340.063 147.385 338.317 153.343C337.848 154.943 336.363 156 334.706 156H243.056C241.697 156 240.76 154.628 241.247 153.351L242.999 148.76C248.595 134.03 264.56 121.963 279.331 121.256L307.33 119.813C308.826 119.736 310 118.492 310 116.985C310 115.485 308.838 114.245 307.351 114.157L281.059 112.601C266.924 111.877 260.018 99.2932 263.82 86.179L268.195 71.0866C268.64 69.5514 269.971 68.4343 271.557 68.3476C272.738 68.2831 273.928 68.25 275.125 68.25Z"
          />
          <path
            fill="#FF5F08"
            d="M184.062 0C222 0 253.868 26.1297 262.882 61.4824C263.26 62.967 263.142 64.5333 262.601 65.9662L255.383 85.0897C249.787 99.8196 235.406 112.593 219.134 112.593L93.7928 114.043C92.2801 114.061 91.063 115.3 91.0625 116.823C91.0625 118.344 92.2776 119.585 93.789 119.605L217.365 121.248C231.531 121.248 238.406 134.556 234.606 147.671L233.011 153.189C232.53 154.855 231.014 156 229.291 156H3.90889C1.98075 156 0.330745 154.574 0.17634 152.64C0.0594555 151.175 0 149.695 0 148.2C0 119.723 21.6617 96.3403 49.306 93.8266C48.7387 91.2419 48.4375 88.5564 48.4375 85.8C48.4375 65.3379 64.919 48.75 85.25 48.75C93.3413 48.75 100.822 51.3789 106.897 55.8321C117.716 23.3806 148.176 0 184.062 0Z"
          />
        </svg>
        Dev School
      </a>
    )
  }

  {
    [agentSetup].map((course) => (
      <>
        <a
          class="section-label section-label-link"
          href={coursePath(course.name)}
          aria-current={currentPath === coursePath(course.name) ? "page" : undefined}
        >
          {course.title}
        </a>
        <ol class="item-list">
          {course.exercises.map((exercise, index) => {
            const href = exercisePath(course.name, exercise.slug);
            return (
              <li data-course={course.name} data-exercise={exercise.slug}>
                <a href={href} aria-current={currentPath === href ? "page" : undefined}>
                  <span class="title" title={exercise.title}>
                    {/* Zero-based, like the exercise files: the interview is "00." */}
                    <span class="index">{String(index).padStart(2, "0")}.</span> {exercise.title}
                  </span>
                  <span class="check" hidden aria-label="Completed">
                    ✓
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </>
    ))
  }

  {
    tracks.map((track) => {
      const renderCourse = (mock: { title: string; name?: string }) => {
        const course = mock.name ? byName.get(mock.name) : undefined;
        const href = course ? coursePath(course.name) : "#";
        const inCourse = course && currentPath.startsWith(coursePath(course.name));
        return (
          <li>
            <a href={href} aria-current={course && currentPath === href ? "page" : undefined}>
              <span class="title" title={mock.title}>
                {mock.title}
              </span>
            </a>
            {inCourse && (
              <ol class="item-list nested">
                {course.exercises.map((exercise, index) => {
                  const exHref = exercisePath(course.name, exercise.slug);
                  return (
                    <li data-course={course.name} data-exercise={exercise.slug}>
                      <a href={exHref} aria-current={currentPath === exHref ? "page" : undefined}>
                        <span class="title" title={exercise.title}>
                          <span class="index">{String(index).padStart(2, "0")}.</span> {exercise.title}
                        </span>
                        <span class="check" hidden aria-label="Completed">
                          ✓
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ol>
            )}
          </li>
        );
      };
      const visible = track.courses.slice(0, VISIBLE_PER_TRACK);
      const rest = track.courses.slice(VISIBLE_PER_TRACK);
      return (
        <>
          <p class="section-label">{track.label}</p>
          <ol class="item-list">{visible.map(renderCourse)}</ol>
          {rest.length > 0 && (
            <details class="more">
              <summary>
                <span class="when-closed">More +</span>
                <span class="when-open">Less −</span>
              </summary>
              <ol class="item-list">{rest.map(renderCourse)}</ol>
            </details>
          )}
        </>
      );
    })
  }

  <a
    class="section-label section-label-link"
    href="/authors"
    aria-current={currentPath === "/authors" ? "page" : undefined}
  >
    Write a course
  </a>

  <div id="account-section" hidden>
    <p class="section-label">Account</p>
    <ol class="item-list">
      <li>
        <a href="/profile" aria-current={currentPath === "/profile" ? "page" : undefined}>Profile</a>
      </li>
      <li>
        <a href="/disenroll">Disenroll</a>
      </li>
    </ol>
  </div>
</nav>

<style>
  .curriculum-sidebar {
    display: none;
    flex-shrink: 0;
    width: 240px;
    padding: 1.75rem 1rem;
    border-right: 1px solid var(--border);
    background: light-dark(#f9f7f6, color-mix(in oklch, var(--fg) 3%, var(--bg)));
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0.5rem 1.5rem;
    text-decoration: none;
    color: var(--fg);
    font-weight: 800;
    font-size: 1rem;
  }

  .brand-logo {
    flex-shrink: 0;
  }

  .section-label {
    margin: 2rem 0.5rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in oklch, var(--fg) 45%, transparent);
  }

  .brand + .section-label,
  .curriculum-sidebar > .section-label:first-child {
    margin-top: 0;
  }

  a.section-label-link {
    display: block;
    text-decoration: none;
  }

  a.section-label-link:hover,
  a.section-label-link[aria-current="page"] {
    color: var(--fg);
  }

  .item-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .item-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem;
    border-radius: 0.4rem;
    font-size: 0.88rem;
    text-decoration: none;
    color: var(--muted-fg);
  }

  .item-list a {
    color: var(--fg);
  }

  .item-list a:hover {
    background: var(--card-bg);
  }

  .item-list a[aria-current="page"] {
    background: color-mix(in oklch, var(--accent) 12%, transparent);
    color: var(--accent);
    font-weight: 600;
  }

  .item-list a[aria-current="page"] .index {
    color: color-mix(in oklch, var(--accent) 70%, transparent);
  }

  .title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .index {
    color: color-mix(in oklch, var(--fg) 35%, transparent);
    margin-right: 0.15rem;
    font-variant-numeric: tabular-nums;
  }

  .check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 9999px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .check[hidden] {
    display: none;
  }

  .item-list.nested {
    margin: 0.1rem 0 0.3rem 0.75rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--border);
  }

  .more summary {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    font-size: 0.75rem;
    color: color-mix(in oklch, var(--fg) 45%, transparent);
    cursor: pointer;
    list-style: none;
  }

  .more summary::-webkit-details-marker {
    display: none;
  }

  .more summary:hover {
    color: var(--fg);
  }

  .more[open] summary {
    order: 1;
  }

  .more[open] .when-closed,
  .more:not([open]) .when-open {
    display: none;
  }

  .more[open] {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 900px) {
    .curriculum-sidebar {
      display: block;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }
  }
</style>

<script>
  import { initCurriculumSidebar } from "../lib/curriculum-sidebar-client";
  initCurriculumSidebar();
</script>
