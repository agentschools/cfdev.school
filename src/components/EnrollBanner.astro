---
/**
 * The "Enroll for free" banner on course and exercise pages, shown to visitors
 * who haven't enrolled. Server-rendered hidden; each page's client script
 * reveals it when there's no cached student, by the `id` passed in.
 * Design: "Enroll CTA — D (Orange banner)" in Paper's Scratchpad file.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div id={id} class="enroll-banner" hidden>
  <div class="enroll-banner-text">
    <p class="enroll-banner-title">Enroll for free</p>
    <p class="enroll-banner-body">Track your progress through this course, and pick up where you left off.</p>
  </div>
  <a class="enroll-banner-button" href="/">Get a student ID <span aria-hidden="true">→</span></a>
</div>

<style>
  .enroll-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 1.75rem;
    margin: 0 0 2rem;
    padding: 1.75rem 1.75rem 1.75rem 2rem;
    border-radius: 1rem;
    background-image: linear-gradient(in oklab 120deg, oklab(69% 0.149 0.134) 0%, oklab(57% 0.146 0.106) 100%);
    color: #fff;
  }

  .enroll-banner[hidden] {
    display: none;
  }

  .enroll-banner-text {
    display: flex;
    flex: 1 1 16rem;
    flex-direction: column;
    gap: 0.375rem;
  }

  .enroll-banner-title {
    margin: 0;
    font-family: var(--heading-font);
    font-size: 1.625rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .enroll-banner-body {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.45;
    color: rgb(255 255 255 / 92%);
  }

  .enroll-banner-button {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    background: #fff;
    color: #1c1c1c;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.25rem;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .enroll-banner-button:hover {
    transform: translateX(2px);
  }

  .enroll-banner-button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .enroll-banner-button {
      transition: none;
    }

    .enroll-banner-button:hover {
      transform: none;
    }
  }
</style>
