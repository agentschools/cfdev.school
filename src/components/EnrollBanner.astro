---
/**
 * The "Enroll for free" banner on course and exercise pages, shown to visitors
 * who haven't enrolled. Server-rendered hidden; each page's client script
 * reveals it when there's no cached student, by the `id` passed in.
 * Design: "Enroll CTA — D (Orange banner)" in Paper's Scratchpad file.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div id={id} class="enroll-banner" hidden>
  <div class="enroll-banner-text">
    <p class="enroll-banner-title">Enroll for free</p>
    <p class="enroll-banner-body">Track your progress through this course, and pick up where you left off.</p>
  </div>
  <a class="enroll-banner-button" href="/">Get a student ID <span aria-hidden="true">→</span></a>
</div>

<style>
  .enroll-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin: 0 0 2rem;
    padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    border-radius: 0.75rem;
    background: var(--accent);
    color: #fff;
  }

  .enroll-banner[hidden] {
    display: none;
  }

  .enroll-banner-text {
    display: flex;
    flex: 1 1 16rem;
    flex-direction: column;
    gap: 0.25rem;
  }

  .enroll-banner-title {
    margin: 0;
    font-family: var(--heading-font);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .enroll-banner-body {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.45;
    color: rgb(255 255 255 / 80%);
  }

  .enroll-banner-button {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: #fff;
    color: #1c1c1c;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25rem;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .enroll-banner-button:hover {
    transform: translateX(2px);
  }

  .enroll-banner-button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .enroll-banner-button {
      transition: none;
    }

    .enroll-banner-button:hover {
      transform: none;
    }
  }
</style>
