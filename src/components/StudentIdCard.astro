---
---

<div id="student-id-card" class="id-card">
  <div id="celebration-layer" class="celebration-layer" aria-hidden="true"></div>
  <div class="id-card-face">
    <p class="id-card-label">Cloudflare Dev School Student ID</p>
    <!-- Sample ID until the student enrolls; enroll-client.ts cipher-reveals their real one over it. -->
    <p id="student-id-display" class="id-card-id">smooth-operator-4629</p>
  </div>
</div>

<style>
  .id-card {
    position: relative;
    width: min(26.25rem, 100%);
    container-type: inline-size;
  }

  .celebration-layer {
    position: absolute;
    inset: -80px;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .id-card-face {
    position: relative;
    z-index: 2;
    aspect-ratio: 420 / 265;
    border-radius: 22px;
    padding: 1.9rem 2.05rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(135deg, #ff8f45 0%, #ff5e1f 48%, #b83200 100%);
    color: #fff;
    rotate: -4deg;
    box-shadow:
      0 24px 48px rgb(0 0 0 / 0.16),
      0 6px 14px rgb(0 0 0 / 0.08);
  }

  .id-card-label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .id-card-id {
    margin: 0;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: min(1.75rem, 6.2cqi);
    font-weight: 800;
    white-space: nowrap;
  }

  :global(.celebration-particle) {
    position: absolute;
    pointer-events: none;
    width: var(--size);
    height: var(--size);
    background: var(--color);
    border-radius: var(--radius);
    translate: -50% -50%;
    animation: particle-fly var(--dur) cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  @keyframes particle-fly {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translate(var(--vx), var(--vy)) rotate(var(--rot));
      opacity: 0;
    }
  }
</style>
