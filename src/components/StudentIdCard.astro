---
---

<div id="student-id-card" class="id-card" hidden>
  <div id="celebration-layer" class="celebration-layer" aria-hidden="true"></div>
  <div class="id-card-face">
    <p class="id-card-label">Cloudflare Dev School Student ID</p>
    <p id="student-id-display" class="id-card-id"></p>
  </div>
</div>

<style>
  .id-card {
    position: relative;
    max-width: 22rem;
    margin: 0 0 1.75rem;
    opacity: 0;
    transform: translateY(10px) scale(0.98);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .id-card[hidden] {
    display: none;
  }

  .id-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .celebration-layer {
    position: absolute;
    inset: -80px;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .id-card-face {
    position: relative;
    z-index: 2;
    aspect-ratio: 85.6 / 54;
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(135deg, var(--accent), color-mix(in oklch, var(--accent) 60%, purple));
    color: var(--accent-contrast);
  }

  .id-card-label {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.85;
  }

  .id-card-id {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  :global(.celebration-particle) {
    position: absolute;
    pointer-events: none;
    width: var(--size);
    height: var(--size);
    background: var(--color);
    border-radius: var(--radius);
    translate: -50% -50%;
    animation: particle-fly var(--dur) cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  @keyframes particle-fly {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translate(var(--vx), var(--vy)) rotate(var(--rot));
      opacity: 0;
    }
  }
</style>
