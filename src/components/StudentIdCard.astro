---
---

<div id="student-id-card" class="id-card">
  <div id="celebration-layer" class="celebration-layer" aria-hidden="true"></div>
  <div class="id-card-face">
    <p class="id-card-label">Cloudflare Dev School Student ID</p>
    <!-- Sample ID until the student enrolls; enroll-client.ts cipher-reveals their real one over it. -->
    <p id="student-id-display" class="id-card-id">smooth-operator-4629</p>
  </div>
</div>

<style>
  .id-card {
    position: relative;
    width: min(26.25rem, 100%);
    container-type: inline-size;
    /* enroll-client.ts switches the homepage to the dashboard inside a view
       transition; this carries the card from the hero into its new spot. */
    view-transition-name: student-id-card;
  }

  .celebration-layer {
    position: absolute;
    inset: -80px;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .id-card-face {
    position: relative;
    z-index: 2;
    aspect-ratio: 420 / 265;
    border-radius: 22px;
    padding: 1.9rem 2.05rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(135deg, #ff8f45 0%, #ff5e1f 48%, #b83200 100%);
    color: #fff;
    rotate: -4deg;
    overflow: hidden;
    box-shadow:
      0 24px 48px rgb(0 0 0 / 0.16),
      0 6px 14px rgb(0 0 0 / 0.08);
    transition:
      translate 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      scale 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      rotate 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s ease;
  }

  /* A light sweep across the face, only while a fresh ID is being minted. */
  .id-card-face::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.32) 50%, transparent 65%);
    translate: -100% 0;
    pointer-events: none;
  }

  /* Set by enroll-client.ts during a fresh enrollment's reveal. */
  .id-card:global(.is-minting) .id-card-face {
    translate: 0 -10px;
    scale: 1.04;
    rotate: -1deg;
    box-shadow:
      0 36px 64px rgb(0 0 0 / 0.22),
      0 10px 20px rgb(0 0 0 / 0.1),
      0 0 0 1px rgb(255 255 255 / 0.12) inset;
  }

  .id-card:global(.is-minting) .id-card-face::after {
    animation: card-shimmer 1.4s ease-in-out infinite;
  }

  /* Set once the ID lands, for the confetti. */
  .id-card:global(.is-minted) .id-card-face {
    animation: card-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow:
      0 24px 48px rgb(0 0 0 / 0.16),
      0 6px 14px rgb(0 0 0 / 0.08),
      0 0 56px rgb(255 110 40 / 0.5);
  }

  :global(::view-transition-group(student-id-card)) {
    animation-duration: 0.7s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation-duration: 0.45s;
  }

  @keyframes card-shimmer {
    to {
      translate: 100% 0;
    }
  }

  @keyframes card-pop {
    0% {
      scale: 1.04;
    }
    40% {
      scale: 1.08;
    }
    100% {
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .id-card-face {
      transition: none;
    }

    .id-card:global(.is-minting) .id-card-face {
      translate: none;
      scale: none;
      rotate: -4deg;
    }

    .id-card:global(.is-minting) .id-card-face::after,
    .id-card:global(.is-minted) .id-card-face {
      animation: none;
    }
  }

  .id-card-label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .id-card-id {
    margin: 0;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: min(1.75rem, 6.2cqi);
    font-weight: 800;
    white-space: nowrap;
  }

  :global(.celebration-particle) {
    position: absolute;
    pointer-events: none;
    width: var(--size);
    height: var(--size);
    background: var(--color);
    border-radius: var(--radius);
    translate: -50% -50%;
    animation: particle-fly var(--dur) cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  @keyframes particle-fly {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translate(var(--vx), var(--vy)) rotate(var(--rot));
      opacity: 0;
    }
  }
</style>
