---
---

<section id="agent-prompt" class="agent-prompt" hidden>
  <p class="agent-prompt-label">Copy this prompt, then paste it into the message box of your coding-agent app:</p>
  <p class="agent-prompt-help">New to coding agents? <a href="/agents">Find an app to use</a>.</p>
  <div class="agent-prompt-box">
    <pre id="agent-prompt-text" class="agent-prompt-text"></pre>
    <button id="agent-prompt-copy" type="button" class="agent-prompt-copy">Copy</button>
  </div>
  <p id="agent-prompt-confirm" class="agent-prompt-confirm" role="status" hidden>Copied! Paste it into the message box of your coding-agent app and send it.</p>
</section>

<style>
  /* Modeled on OpenCode School's prompt card, in our accent color. */
  .agent-prompt[hidden] {
    display: none;
  }

  .agent-prompt {
    max-width: 40rem;
    margin: 0 0 2rem;
    text-align: left;
  }

  .agent-prompt-label {
    margin: 0 0 0.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--fg);
  }

  .agent-prompt-help {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    color: var(--fg);
  }

  .agent-prompt-box {
    position: relative;
    overflow: hidden;
    border: 2px solid var(--accent);
    border-left-width: 6px;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--accent) 5%, var(--bg));
    box-shadow:
      0 0 0 3px color-mix(in oklch, var(--accent) 12%, transparent),
      0 4px 16px color-mix(in oklch, var(--accent) 15%, transparent);
  }

  .agent-prompt-text {
    margin: 0;
    padding: 1rem 1.25rem;
    padding-right: 5rem;
    white-space: pre-wrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--fg);
  }

  .agent-prompt-copy {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.25rem 0.6rem;
    border: none;
    border-radius: 0.3rem;
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
  }

  .agent-prompt-copy:hover {
    filter: brightness(1.08);
  }

  .agent-prompt-confirm {
    margin: 1.25rem 0 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    color: var(--fg);
  }
</style>
